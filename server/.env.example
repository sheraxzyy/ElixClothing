# ─────────────────────────────────────────────────────────────────────────────
# ELIX Server — Environment Variables Example
# Copy this file to .env and configure your production credentials
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=production

# ── DATABASE ARCHITECTURE (PostgreSQL on Supabase with Prisma) ───────────────
# DATABASE_URL: Supabase Session Pooler (port 6543) for runtime application queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Supabase Direct Connection (port 5432) for Prisma CLI migrations & schema push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── AUTHENTICATION & SECURITY ────────────────────────────────────────────────
JWT_SECRET="your-ultra-secure-256-bit-random-secret-key-here"
CLIENT_URL="http://localhost:5173"

# ── ADMIN & STORE ATELIER CREDENTIALS ────────────────────────────────────────
ADMIN_EMAIL="admin@elix.lk"
ADMIN_PASSWORD="YourSecureAdminPassword"

OWNER_EMAIL="owner@elix.lk"
OWNER_PASSWORD="YourSecureOwnerPassword"

# ── SMTP EMAIL NOTIFICATIONS (Order Dispatch, Tracking & Restock Alerts) ─────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@elix.lk"
SMTP_PASS="your-app-specific-email-password"
EMAIL_FROM="ELIX Streetwear Atelier <notifications@elix.lk>"
