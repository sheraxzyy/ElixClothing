# ─────────────────────────────────────────────────────────────────────────────
# ELIX Server — Environment Variables Example
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# (If your password has '@', URL-encode it as '%40')
DATABASE_URL="postgresql://elixuser:YourStrongPassword123!@YOUR_VPS_PUBLIC_IP:5432/elixdb?schema=public"

JWT_SECRET=change_this_to_a_long_random_secret

CLIENT_URL=http://localhost:5173

# Admin & Store Owner Credentials
ADMIN_EMAIL="admin@elix.lk"
ADMIN_PASSWORD="March3@2211"

OWNER_EMAIL="sheranadeesha39@gmail.com"
OWNER_PASSWORD="March3@2211"
