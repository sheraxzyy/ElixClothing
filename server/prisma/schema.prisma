generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  realName           String
  username           String              @unique
  email              String              @unique
  password           String?
  role               Role                @default(customer)
  provider           Provider            @default(email)
  avatar             String?
  points             Int                 @default(200)
  isDemo             Boolean             @default(false)
  phone              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlist           WishlistItem[]
  stockNotifications StockNotification[]
  recentlyViewed     RecentlyViewed[]

  @@index([email])
  @@index([username])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  street     String?
  city       String?
  postalCode String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String
  imageUrl           String
  price              Float
  costPrice          Float?              @default(0)
  priority           Int                 @default(0)
  category           String              @default("Uncategorized")
  isFeatured         Boolean             @default(false)
  isBestSeller       Boolean             @default(false)
  rating             Float               @default(0)
  numReviews         Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  images             ProductImage[]
  sizes              ProductSize[]
  reviews            Review[]
  wishlist           WishlistItem[]
  dropProducts       DropProduct[]
  stockNotifications StockNotification[]
  recentlyViewed     RecentlyViewed[]

  @@index([slug])
  @@index([priority])
  @@index([category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  size      Size
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Discount {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Float
  expiryDate  DateTime
  usageLimit  Int          @default(0)
  usedCount   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Order {
  id                String               @id @default(cuid())
  userId            String
  paymentMethod     String               @default("Cash on Delivery")
  itemsPrice        Float
  deliveryFee       Float
  discountAmount    Float                @default(0)
  totalPrice        Float
  status            OrderStatus          @default(Pending)
  isPaid            Boolean              @default(false)
  paidAt            DateTime?
  deliveredAt       DateTime?
  shippedAt         DateTime?
  courierName       String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  internalNotes     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  shippingAddress   ShippingAddress?
  trackingEvents    OrderTrackingEvent[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  image     String
  price     Float
  quantity  Int
  size      Size?
  color     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model ShippingAddress {
  id         String @id @default(cuid())
  orderId    String @unique
  fullName   String
  phone      String
  street     String
  city       String
  postalCode String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderTrackingEvent {
  id             String      @id @default(cuid())
  orderId        String
  status         OrderStatus
  description    String
  courierName    String?
  trackingNumber String?
  location       String?
  updatedBy      String      @default("System")
  timestamp      DateTime    @default(now())
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([timestamp])
}

model Drop {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  banner      String
  scheduledAt DateTime
  timezone    String        @default("Asia/Colombo")
  status      DropStatus    @default(Draft)
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    DropProduct[]

  @@index([slug])
  @@index([status])
  @@index([scheduledAt])
}

model DropProduct {
  id             String   @id @default(cuid())
  dropId         String
  productId      String
  exclusiveStock Int      @default(0)
  dropPrice      Float?
  drop           Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dropId, productId])
  @@index([dropId])
  @@index([productId])
}

model StockNotification {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  productId  String
  size       Size
  color      String?
  status     String    @default("active") // "active", "notified", "unsubscribed"
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, size, status])
  @@index([email])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Message {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  inquiryType String   @default("General Inquiry")
  orderNumber String?
  message     String
  status      String   @default("unread")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

enum Role {
  customer
  admin
  owner
}

enum Provider {
  email
  google
  apple
  github
  system
}

enum Size {
  S
  M
  L
  XL
  XXL
}

enum DiscountType {
  percentage
  fixed
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  PreparingForShipment
  Shipped
  OutForDelivery
  Delivered
  Cancelled
  DeliveryFailed
  Returned
}

enum DropStatus {
  Draft
  Scheduled
  Upcoming
  Live
  SoldOut
  Ended
  Cancelled
}
